        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Duplicate Employee\",\n  \"email\": \"postman.employee@test.com\",\n  \"role\": \"Employee\",\n  \"password\": \"Test@1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/admin/users",
          "protocol": "http",
          "host": ["localhost"],
