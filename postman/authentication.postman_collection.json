      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueEmail = `postman.employee.${Date.now()}@test.com`;",
              "pm.collectionVariables.set(\"testUserEmail\", uniqueEmail);"
