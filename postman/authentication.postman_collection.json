    {
      "name": "API-01 - Valid Employee Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API-01: returns HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"API-01: returns successful login message\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"Login successful.\");",
              "});",
              "",
              "pm.test(\"API-01: returns authenticated employee email\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.email).to.eql(\"employee@test.com\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"employee@test.com\",\n  \"password\": \"Test@1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/auth/login",
          "protocol": "http",
