          "script": {
            "exec": [
              "pm.test(\"API-05: returns HTTP 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"API-05: returns duplicate email error\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error).to.eql(\"A user with this email already exists.\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
