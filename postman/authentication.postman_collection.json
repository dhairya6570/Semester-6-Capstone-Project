    {
      "name": "API-04 - Successful Admin User Creation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API-04: returns HTTP 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"API-04: returns successful creation message\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"User account created successfully.\");",
              "});",
              "",
              "pm.test(\"API-04: creates Employee account\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.email).to.eql(\"postman.employee@test.com\");",
              "    pm.expect(json.user.role).to.eql(\"Employee\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Employee\",\n  \"email\": \"postman.employee@test.com\",\n  \"role\": \"Employee\",\n  \"password\": \"Test@1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/admin/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "admin", "users"]
        }
      }
    },
    {
      "name": "API-05 - Duplicate Email",
