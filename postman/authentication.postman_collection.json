{
  "info": {
    "name": "IT Asset Support Ticket Management - Authentication and User Management",
    "description": "Automated Week 2 and Week 3 authentication and user management API tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API-01 - Valid Employee Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API-01: returns HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"API-01: returns successful login message\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql(\"Login successful.\");",
              "});",
              "",
              "pm.test(\"API-01: returns authenticated employee email\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.email).to.eql(\"employee@test.com\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"employee@test.com\",\n  \"password\": \"Test@1234\"\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "API-02 - Invalid Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"API-02: returns HTTP 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"API-02: returns invalid credentials error\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error).to.eql(\"Invalid email or password.\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"employee@test.com\",\n  \"password\": \"WrongPassword@123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3001/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3001",
          "path": ["api", "auth", "login"]
        }
      }
    },
